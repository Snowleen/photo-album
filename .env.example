# Copy to .env.local for local dev. On Vercel, add these in Project Settings -> Environment Variables.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Superadmin login (kept out of the code so it never appears on GitHub)
SUPERADMIN_USERNAME=your-superadmin-username
SUPERADMIN_PASSWORD=your-superadmin-password

# Any long random string (used to sign login cookies)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Any random string (protects the daily recycle-bin cleanup job)
CRON_SECRET=another-random-string
